# Public env vars (safe to expose in the browser). Copy to `.env` and fill in.

# Web3Forms access key -> https://web3forms.com (free: 250 submissions/month)
# Used by the contact form and the newsletter form.
PUBLIC_WEB3FORMS_KEY=

# Newsletter provider endpoint (optional). If set, the newsletter form posts here
# instead of Web3Forms, e.g. a Buttondown / MailerLite subscribe URL.
PUBLIC_NEWSLETTER_ENDPOINT=

# Your live site URL (used for absolute links in emails / metadata)
PUBLIC_SITE_URL=https://yudaikhsan-site.pages.dev

# ---- Site identity (edit these to make it yours) ----
PUBLIC_SITE_NAME=Yudha Ikhsan
PUBLIC_SITE_TAGLINE=Message-grade clarity. Media-grade reach.
PUBLIC_SITE_ROLE=Communication Consultant
PUBLIC_SITE_EMAIL=yudha.ikhsan1993@gmail.com
PUBLIC_SOCIAL_GITHUB=https://github.com/yudaikhsan
PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/yudhaikhsan
PUBLIC_SOCIAL_X=https://x.com/yudhaikhsan
PUBLIC_CAL_URL=https://cal.com/yudhaikhsan/discovery
PUBLIC_STUDIO_URL=https://yudaikhsan-site.pages.dev
PUBLIC_STUDIO_NAME=Ikhsan Communications