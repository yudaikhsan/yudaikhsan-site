---
import Icon from './Icon.astro';
---

<div class="relative" data-theme-toggle>
  <button
    type="button"
    class="btn btn-ghost btn-icon h-9 w-9"
    aria-haspopup="true"
    aria-expanded="false"
    data-theme-trigger
  >
    <Icon
      name="sun"
      class="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0"
    />
    <Icon
      name="moon"
      class="absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
    />
    <span class="sr-only">Toggle theme</span>
  </button>

  <div
    role="menu"
    aria-label="Theme"
    class="absolute right-0 z-50 mt-2 hidden w-36 overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md animate-fade-in"
    data-theme-menu
  >
    <button
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-value="light"
      class="flex w-full items-center rounded-sm px-2 py-1.5 text-sm font-mono hover:bg-accent focus-visible:bg-accent focus-visible:outline-none"
    >
      Light
    </button>
    <button
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-value="dark"
      class="flex w-full items-center rounded-sm px-2 py-1.5 text-sm font-mono hover:bg-accent focus-visible:bg-accent focus-visible:outline-none"
    >
      Dark
    </button>
    <button
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-value="system"
      class="flex w-full items-center rounded-sm px-2 py-1.5 text-sm font-mono hover:bg-accent focus-visible:bg-accent focus-visible:outline-none"
    >
      System
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'vite-ui-theme';
    const root = document.documentElement;
    const toggles = document.querySelectorAll('[data-theme-toggle]');

    const apply = (theme) => {
      const dark =
        theme === 'dark' ||
        (theme === 'system' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      root.classList.toggle('light', !dark);
      root.classList.toggle('dark', dark);
    };

    const current = () => localStorage.getItem(STORAGE_KEY) || 'light';

    const sync = () => {
      const value = current();
      toggles.forEach((t) => {
        t.querySelectorAll('[data-theme-value]').forEach((btn) => {
          btn.setAttribute(
            'aria-checked',
            btn.dataset.themeValue === value ? 'true' : 'false'
          );
        });
      });
    };

    const setTheme = (theme) => {
      localStorage.setItem(STORAGE_KEY, theme);
      apply(theme);
      sync();
    };

    toggles.forEach((t) => {
      const trigger = t.querySelector('[data-theme-trigger]');
      const menu = t.querySelector('[data-theme-menu]');
      const close = () => {
        menu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
      };
      const open = () => {
        menu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.contains('hidden') ? open() : close();
      });

      menu.querySelectorAll('[data-theme-value]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setTheme(btn.dataset.themeValue);
          close();
          trigger.focus();
        });
      });

      document.addEventListener('click', (e) => {
        if (!t.contains(e.target)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (current() === 'system') apply('system');
      });

    sync();
  })();
</script>