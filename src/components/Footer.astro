---
import { site } from '../config';
import Icon from './Icon.astro';
import NewsletterForm from './NewsletterForm.astro';

const quickLinks = [
  { label: 'Read about me', labelMobile: 'Read About Me', href: '/about' },
  { label: 'Read my writings', labelMobile: 'Read My Writings', href: '/writing' },
  { label: 'Read my research', labelMobile: 'Read My Research', href: '/research' },
  { label: 'Read my portfolio', labelMobile: 'Read My Portfolio', href: '/portfolio' },
  { label: 'Contact me page', labelMobile: 'Contact Me Page', href: '/contact' },
];

const socials = [
  { label: 'X fka Twitter', href: site.social.x, icon: 'twitter' as const },
  { label: 'GitHub', href: site.social.github, icon: 'github' as const },
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'linkedin' as const },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background" role="contentinfo">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Author -->
      <div class="space-y-4">
        <h3 class="text-lg font-medium font-sans">{site.name}</h3>
        <p class="text-sm font-mono tracking-tighter text-muted-foreground">
          {site.role}. I help brands earn trust through clear, credible storytelling — from
          strategy through to measurable coverage.
        </p>
      </div>

      <!-- Quick links (mobile, with image) -->
      <div class="flex flex-row gap-4 md:hidden">
        <div class="flex-1 space-y-8">
          <nav class="space-y-4" aria-labelledby="quick-links-mobile">
            <h3 id="quick-links-mobile" class="text-lg font-medium font-sans">Quick Links</h3>
            <ul class="space-y-2 text-sm font-mono tracking-tighter">
              {
                quickLinks.map((link) => (
                  <li>
                    <a href={link.href} class="text-muted-foreground hover:text-foreground">
                      {link.labelMobile}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <div class="flex w-32 items-center">
          <div class="relative h-48 w-32 overflow-hidden">
            <img
              src="/images/profile.svg"
              alt={`${site.name} in a relaxed pose`}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Quick links (desktop) -->
      <nav class="hidden space-y-4 md:block" aria-labelledby="quick-links-desktop">
        <h3 id="quick-links-desktop" class="text-lg font-medium font-sans">Quick Links</h3>
        <ul class="space-y-2 text-sm font-mono tracking-tighter">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-muted-foreground hover:text-foreground">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Spacer nav (keeps the 4-column rhythm of the original) -->
      <nav class="hidden space-y-4 md:block" aria-label="Accessibility" />

      <!-- Newsletter -->
      <div class="space-y-4">
        <h3 class="text-lg font-medium font-sans">Newsletter</h3>
        <p class="text-sm font-mono tracking-tighter text-muted-foreground">
          Ready to read any interesting things I publish? Subscribe here.
        </p>
        <NewsletterForm />
      </div>
    </div>

    <div
      class="mt-8 flex flex-col items-center justify-between space-y-4 border-t border-border pt-8 md:flex-row md:space-y-0"
    >
      <div class="flex flex-col items-center space-y-2 md:flex-row md:space-x-4 md:space-y-0">
        <p class="text-sm font-mono tracking-tighter text-muted-foreground">
          © {year}
          <a
            href={site.studioUrl}
            class="text-primary hover:text-primary/80"
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.studioName}
          </a>. All rights reserved.
        </p>
        <a
          href="/accessibility"
          class="text-sm font-mono tracking-tighter text-muted-foreground hover:text-foreground"
        >
          Accessibility Statement
        </a>
      </div>

      <div class="flex space-x-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-icon h-9 w-9"
            >
              <Icon name={s.icon} class="h-5 w-5" />
              <span class="sr-only">{s.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>