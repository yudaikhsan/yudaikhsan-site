---
import Icon from './Icon.astro';

export interface Props {
  slug: string;
  title: string;
  description: string;
  image: string;
}

const { slug, title, description, image } = Astro.props;
---

<a href={`/portfolio/${slug}`} class="block h-full">
  <article
    class="card group relative h-full cursor-pointer overflow-hidden transition-all duration-300 hover:scale-105 hover:border-green-400/50 hover:shadow-lg"
  >
    <div
      class="pointer-events-none absolute inset-0 z-10 rounded-lg bg-gradient-to-r from-green-400/0 to-green-400/0 transition-all duration-300 group-hover:from-green-400/5 group-hover:to-green-400/10"
      aria-hidden="true"
    >
    </div>
    <div class="relative aspect-video">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    <div class="relative z-20 p-4">
      <h3 class="font-medium">{title}</h3>
      <p class="mt-2 text-sm text-muted-foreground">{description}</p>
      <div class="mt-2 flex items-center font-mono tracking-tighter">
        Read the story
        <Icon
          name="arrow-right"
          class="ml-1 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        />
      </div>
    </div>
  </article>
</a>