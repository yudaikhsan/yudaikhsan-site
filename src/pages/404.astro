---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has been moved."
>
  <div class="container mx-auto px-4 py-12 md:px-6 md:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="mb-4 text-6xl font-bold font-mono tracking-tighter">404</h1>
      <h2 class="mb-4 text-2xl font-bold">Page Not Found</h2>
      <p class="mb-8 text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" data-button class="btn btn-md btn-primary">
        <Icon name="arrow-right" class="mr-2 h-4 w-4 rotate-180" />
        Go Home
      </a>
    </div>
  </div>
</BaseLayout>